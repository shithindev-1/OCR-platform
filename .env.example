# Copy to .env and fill in. Never commit .env.
# Secrets and the few per-machine switches live here; everything else is in config/settings.json
# (shared defaults) and config/settings.<APP_ENV>.json (per environment, from settings.example.json).
#
# Any setting can be given to ONE service only with a prefix: LEASING_<NAME> or CHEQUE_<NAME>
# (for example CHEQUE_GEMINI_API_KEY), which beats the plain <NAME> that both services read.

# --- Which services this process runs, and where ---
# leasing,cheque = both in one app (default) | leasing | cheque
SERVICES=leasing,cheque
# Read by `python -m app`, which the Windows service runs
APP_HOST=127.0.0.1
APP_PORT=8000
# Reverse-proxy IPs whose X-Forwarded-Proto/For headers are trusted (comma-separated, or *)
FORWARDED_ALLOW_IPS=127.0.0.1
# Swagger UI at /docs - set false on an internet-facing host
DOCS_ENABLED=true
# Browser origins allowed to call the API, e.g. http://localhost:3000,https://app.example.com (empty = none)
CORS_ORIGINS=
# Folder for the log files: <LOG_DIR>/leasing/... and <LOG_DIR>/cheque/... (empty = the project's logs/ folder)
LOG_DIR=
LOG_LEVEL=INFO

# --- Environment ---
# local | uat | prod  -> loads config/settings.<APP_ENV>.json. API_KEYS is required unless local.
APP_ENV=local
# Keys clients send in the X-API-Key header (comma-separated to allow rotation). Empty = auth OFF, local only.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Gemini (one key for both services, or LEASING_GEMINI_API_KEY / CHEQUE_GEMINI_API_KEY) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# --- Azure Blob Storage (or the LEASING_ / CHEQUE_ prefixed forms) ---
AZURE_STORAGE_CONNECTION_STRING=

# ===================== Leasing =====================
# Container whose files /ocr/leasing reads, and where <name>_ocr.<ext> results are uploaded
AZURE_STORAGE_CONTAINER=
# Extra hosts a /ocr/leasing source URL may point at, besides the blob container (comma-separated)
ALLOWED_SOURCE_HOSTS=
REQUIRE_HTTPS=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_MB=15
GEMINI_MAX_TOKENS=2048
# Decoding for every call: always the single most likely answer, same answer on a repeat run
GEMINI_TEMPERATURE=0
GEMINI_SEED=0
GEMINI_TOP_P=1
GEMINI_TOP_K=1
# Faster/cheaper model for the crop + rotation calls only (e.g. a Flash-Lite model); empty = GEMINI_MODEL
GEMINI_VISION_MODEL=
GEMINI_VERIFICATION_THINKING_BUDGET=256
GEMINI_TIMEOUT_SECONDS=105
GEMINI_MAX_IMAGE_EDGE=1568
DETECTION_ENABLED=true
VALIDATION_ENABLED=true
# Reuse a byte-identical file's extraction and passed self-check for this many seconds (memory only, 0 = off)
RESULT_CACHE_SECONDS=10800
DETECTION_OUTPUT_DIR=detections
DETECTION_PDF_DPI=200
DETECTION_CROP_PADDING_PX=10
DETECTION_CROP_PADDING_RATIO=0.015
DETECTION_CROP_TOP_PADDING_RATIO=0.015
DETECTION_ROTATION_MIN_CONFIDENCE=0.7
DETECTION_CROP_TARGET_LONG_EDGE=1600
DETECTION_CROP_SHARPEN_AMOUNT=0.4
DETECTION_CROP_CONTRAST_CLIP=0
# Stored originals/crops/merged PDFs are deleted after this many hours; 0 = keep forever
OUTPUT_RETENTION_HOURS=24
LOG_RETENTION_DAYS=30
# Writes extracted ID data (names, ID numbers, DOB) to the results log - development only, keep false in production
LOG_EXTRACTED_RESULTS=false
LEASING_OUTPUT_DIR=postman_output
COUNTRY_LEARNING_ENABLED=true
COUNTRY_LEARNING_DIR=learned_countries

# ===================== Cheque =====================
# Cheque's other settings (sampling, upload limits, blob base URL, case study...) are in config/settings*.json
