{
  "info": {
    "name": "OCR Platform API",
    "description": "One project, two services: **Leasing OCR** and **Cheque OCR**.\n\n1. Start it: `python -m app` (both services) - Swagger at `{{baseUrl}}/docs`.\n2. Set `baseUrl` (default http://localhost:8000) and `apiKey` (leave empty when API_KEYS is empty locally).\n3. For each upload request, open the Body tab and pick your files in the `file` / `files` rows.\n\nOne `X-API-Key` header is accepted by both services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "ocrFileUrl",
      "value": ""
    },
    {
      "key": "ocrBlobPath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Open (no API key). `/health` is the load-balancer probe; `/api/v1/health` adds the version and which services this process runs.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Health - version and running services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Leasing OCR",
      "description": "Identity and company documents. Errors are `{\"detail\": ...}` (the original `/api/v1/ocr` answers in its own `errorInfo` shape). For plain-http local testing set `REQUIRE_HTTPS=false` in .env.",
      "item": [
        {
          "name": "Upload files (direct)",
          "description": "Attach the files in the Body tab (pick a file in each `file` row). Rows with the same key are paired by position.",
          "item": [
            {
              "name": "Leasing - upload files",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/ocr/leasing/upload",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "ocr",
                    "leasing",
                    "upload"
                  ]
                },
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "tenant_type",
                      "value": "individual",
                      "type": "text",
                      "description": "individual or company - sent once per request"
                    },
                    {
                      "key": "document_refnumber",
                      "value": "1001",
                      "type": "text",
                      "description": "Your reference for this request - sent once per request"
                    },
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "National ID, front"
                    },
                    {
                      "key": "document_id",
                      "value": "16",
                      "type": "text"
                    },
                    {
                      "key": "document_type",
                      "value": "National Id",
                      "type": "text"
                    },
                    {
                      "key": "document_name",
                      "value": "National ID Front",
                      "type": "text"
                    },
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "National ID, back"
                    },
                    {
                      "key": "document_id",
                      "value": "17",
                      "type": "text"
                    },
                    {
                      "key": "document_type",
                      "value": "National Id",
                      "type": "text"
                    },
                    {
                      "key": "document_name",
                      "value": "National ID Back",
                      "type": "text"
                    },
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "Passport"
                    },
                    {
                      "key": "document_id",
                      "value": "18",
                      "type": "text"
                    },
                    {
                      "key": "document_type",
                      "value": "Passport",
                      "type": "text"
                    },
                    {
                      "key": "document_name",
                      "value": "Passport",
                      "type": "text"
                    }
                  ]
